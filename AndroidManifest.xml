<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.mr.videohelper">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.chaoxing.mobile" /></queries>
    <application android:label="视频播放助手" android:icon="@drawable/ic_helper" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".PlaybackService" android:label="学习通视频辅助" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/playback_accessibility" />
        </service>
        <receiver android:name=".ControlReceiver" android:exported="false" />
    </application>
</manifest>
